{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "Existing protobuf fields expressed as JSON; execution evidence required by acceptance",
  "required": [
    "code",
    "user_id",
    "recommendations",
    "trace"
  ],
  "properties": {
    "code": {
      "const": 200
    },
    "user_id": {
      "type": "string"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item_id"
        ],
        "properties": {
          "item_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "semantic_id": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "score": {
            "type": "number"
          }
        }
      }
    },
    "trace": {
      "type": "object",
      "required": [
        "backend",
        "runner_calls",
        "request_id"
      ],
      "properties": {
        "backend": {
          "const": "trtllm_cpp"
        },
        "runner_calls": {
          "type": "integer",
          "minimum": 1
        },
        "request_id": {
          "type": "string"
        },
        "datasystem_expected": {
          "type": "boolean"
        },
        "datasystem_attribution_complete": {
          "type": "boolean"
        }
      }
    }
  },
  "additionalProperties": true
}
